# Used by compose.yaml at the repository root. Copy to .env and adjust. .env is git-ignored.

# production disables the Swagger docs; use development to serve them at /docs.
NODE_ENV=production

# Public URL of Gatehouse (no trailing slash). Ends up in the "iss" claim of every token.
GATEHOUSE_ISSUER=http://localhost:9000

# Encrypts the realms' private signing keys at rest. 32 random bytes in base64.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Use the same value as backend/.env to share the database with a backend running outside Docker.
GATEHOUSE_KEY_ENCRYPTION_KEY=

# Initial admin of the master realm. Only read while the master realm does not exist.
GATEHOUSE_ADMIN_USERNAME=admin
GATEHOUSE_ADMIN_EMAIL=admin@gatehouse.local
GATEHOUSE_ADMIN_PASSWORD=change-me-at-least-12-chars
