# Used by npm run test:e2e. Copy to .env.test and adjust. .env.test is git-ignored.
# The e2e tests delete and recreate data, including the master realm; the database name must end in _test.

NODE_ENV=test
PORT=9000
GATEHOUSE_ISSUER=http://localhost:9000

DATABASE_URL=postgresql://gatehouse:gatehouse@localhost:5433/gatehouse_test?schema=public

# Test-only key. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GATEHOUSE_KEY_ENCRYPTION_KEY=

GATEHOUSE_ADMIN_USERNAME=admin
GATEHOUSE_ADMIN_EMAIL=admin@gatehouse.local
GATEHOUSE_ADMIN_PASSWORD=test-only-admin-password
