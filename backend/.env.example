# Copy to .env and adjust. .env is git-ignored.

NODE_ENV=development
PORT=9000

# Public URL of Gatehouse (no trailing slash). Ends up in the "iss" claim of every token.
GATEHOUSE_ISSUER=http://localhost:9000

DATABASE_URL=postgresql://gatehouse:gatehouse@localhost:5433/gatehouse?schema=public

# Initial admin of the master realm. Only read while the master realm does not exist.
GATEHOUSE_ADMIN_USERNAME=admin
GATEHOUSE_ADMIN_EMAIL=admin@gatehouse.local
GATEHOUSE_ADMIN_PASSWORD=change-me-at-least-12-chars
