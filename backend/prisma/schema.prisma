generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum LoginIdentifier {
  USERNAME
  EMAIL
  USERNAME_OR_EMAIL
}

enum ClientType {
  PUBLIC
  CONFIDENTIAL
}

enum GrantType {
  AUTHORIZATION_CODE
  REFRESH_TOKEN
  CLIENT_CREDENTIALS
}

model Realm {
  id                String          @id @default(uuid(7)) @db.Uuid
  name              String          @unique
  displayName       String          @map("display_name")
  enabled           Boolean         @default(true)
  loginIdentifier   LoginIdentifier @default(USERNAME_OR_EMAIL) @map("login_identifier")
  passwordMinLength Int             @default(12) @map("password_min_length")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  users   User[]
  clients Client[]

  @@map("realms")
}

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  realmId       String   @map("realm_id") @db.Uuid
  username      String   @db.Citext
  email         String   @db.Citext
  emailVerified Boolean  @default(false) @map("email_verified")
  passwordHash  String   @map("password_hash")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  realm Realm @relation(fields: [realmId], references: [id], onDelete: Cascade)

  @@unique([realmId, username])
  @@unique([realmId, email])
  @@map("users")
}

model Client {
  id           String      @id @default(uuid(7)) @db.Uuid
  realmId      String      @map("realm_id") @db.Uuid
  clientId     String      @map("client_id")
  name         String
  type         ClientType
  secretHash   String?     @map("secret_hash")
  redirectUris String[]    @map("redirect_uris")
  grantTypes   GrantType[] @map("grant_types")
  enabled      Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  realm Realm @relation(fields: [realmId], references: [id], onDelete: Cascade)

  @@unique([realmId, clientId])
  @@map("clients")
}
