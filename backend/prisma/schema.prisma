generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum LoginIdentifier {
  USERNAME
  EMAIL
  USERNAME_OR_EMAIL
}

enum ClientType {
  PUBLIC
  CONFIDENTIAL
}

enum GrantType {
  AUTHORIZATION_CODE
  REFRESH_TOKEN
  CLIENT_CREDENTIALS
}

enum SigningKeyStatus {
  ACTIVE
  PASSIVE
}

model Realm {
  id                  String          @id @default(uuid(7)) @db.Uuid
  name                String          @unique
  displayName         String          @map("display_name")
  enabled             Boolean         @default(true)
  loginIdentifier     LoginIdentifier @default(USERNAME_OR_EMAIL) @map("login_identifier")
  passwordMinLength   Int             @default(12) @map("password_min_length")
  accessTokenLifespan Int             @default(300) @map("access_token_lifespan")
  sessionIdleTimeout  Int             @default(1800) @map("session_idle_timeout")
  sessionMaxLifespan  Int             @default(36000) @map("session_max_lifespan")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  users       User[]
  clients     Client[]
  signingKeys SigningKey[]
  roles       Role[]
  sessions    Session[]

  @@map("realms")
}

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  realmId       String   @map("realm_id") @db.Uuid
  username      String   @db.Citext
  email         String   @db.Citext
  emailVerified Boolean  @default(false) @map("email_verified")
  passwordHash  String   @map("password_hash")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  realm              Realm               @relation(fields: [realmId], references: [id], onDelete: Cascade)
  roles              UserRole[]
  sessions           Session[]
  authorizationCodes AuthorizationCode[]
  refreshTokens      RefreshToken[]

  @@unique([realmId, username])
  @@unique([realmId, email])
  @@unique([realmId, id])
  @@map("users")
}

model Client {
  id           String      @id @default(uuid(7)) @db.Uuid
  realmId      String      @map("realm_id") @db.Uuid
  clientId     String      @map("client_id")
  name         String
  type         ClientType
  secretHash   String?     @map("secret_hash")
  redirectUris String[]    @map("redirect_uris")
  grantTypes   GrantType[] @map("grant_types")
  enabled      Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  realm Realm @relation(fields: [realmId], references: [id], onDelete: Cascade)

  authorizationCodes AuthorizationCode[]
  refreshTokens      RefreshToken[]

  @@unique([realmId, clientId])
  @@unique([realmId, id])
  @@map("clients")
}

model SigningKey {
  id                  String           @id @default(uuid(7)) @db.Uuid
  realmId             String           @map("realm_id") @db.Uuid
  algorithm           String           @default("ES256")
  status              SigningKeyStatus
  publicJwk           Json             @map("public_jwk")
  encryptedPrivateKey String           @map("encrypted_private_key")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  realm Realm @relation(fields: [realmId], references: [id], onDelete: Cascade)

  @@index([realmId, status])
  @@map("signing_keys")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  realmId     String   @map("realm_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  realm Realm      @relation(fields: [realmId], references: [id], onDelete: Cascade)
  users UserRole[]

  @@unique([realmId, name])
  @@unique([realmId, id])
  @@map("roles")
}

model UserRole {
  realmId   String   @map("realm_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [realmId, userId], references: [realmId, id], onDelete: Cascade)
  role Role @relation(fields: [realmId, roleId], references: [realmId, id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([realmId, roleId])
  @@map("user_roles")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  realmId    String   @map("realm_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  authTime   DateTime @map("auth_time") @db.Timestamptz
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  realm              Realm               @relation(fields: [realmId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [realmId, userId], references: [realmId, id], onDelete: Cascade)
  authorizationCodes AuthorizationCode[]
  refreshTokens      RefreshToken[]

  @@index([realmId, userId])
  @@map("sessions")
}

model AuthorizationCode {
  id            String    @id @default(uuid(7)) @db.Uuid
  realmId       String    @map("realm_id") @db.Uuid
  codeHash      String    @unique @map("code_hash")
  clientId      String    @map("client_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  redirectUri   String    @map("redirect_uri")
  scope         String
  codeChallenge String    @map("code_challenge")
  nonce         String?
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  client  Client  @relation(fields: [realmId, clientId], references: [realmId, id], onDelete: Cascade)
  user    User    @relation(fields: [realmId, userId], references: [realmId, id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("authorization_codes")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  realmId   String    @map("realm_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @default(uuid(7)) @map("family_id") @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  scope     String
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  client  Client  @relation(fields: [realmId, clientId], references: [realmId, id], onDelete: Cascade)
  user    User    @relation(fields: [realmId, userId], references: [realmId, id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}
